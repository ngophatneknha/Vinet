# Set these in Netlify Environment variables, never commit real values.
OWNER_EMAIL=owner@example.com
# Netlify supplies its database connection automatically after Database is enabled.
# Optional override for a local PostgreSQL development database:
DATABASE_URL=
# Optional one-time activation fallback; usually leave unset.
SETUP_CODE=
# Optional automation importer; browser import uses the signed-in admin session.
IMPORT_TOKEN=
# Exact production origin. Netlify's URL is used if this is unset.
SITE_ORIGIN=
